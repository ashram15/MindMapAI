# ==========================================
# GEMINI API KEY (REQUIRED)
# ==========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
# Development mode (set to 'true' for mock responses without API calls)
DEV_MODE=false

# C++ Vector Engine URL
# - For Docker: http://cpp_engine:8080/search
# - For local dev: http://localhost:8080/search
# - For Render: Will be auto-set from render.yaml
CPP_SERVER_URL=http://localhost:8080/search
